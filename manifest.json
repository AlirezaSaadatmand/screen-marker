{
  "manifest_version": 3,
  "name": "Screen Marker",
  "version": "1.0",
  "description": "Draw on any webpage with your mouse",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Screen Marker"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}